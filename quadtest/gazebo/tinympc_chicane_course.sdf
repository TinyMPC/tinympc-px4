<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tinympc_chicane_course">
    <static>true</static>

    <!--
      The colored floor is the hard center-position corridor used by both
      controllers. It is deliberately visual-only: a controller that misses
      the envelope remains observable instead of turning the demo into a
      collision test. There is no wind or external disturbance.

      PX4 NED x maps to Gazebo world y and PX4 NED y maps to world x.
      The three 0.36 m-wide rectangles form two alternating 90-degree turns.
    -->
    <link name="course_floor">
      <visual name="first_lane">
        <pose>0 0.69 0.008 0 0 0</pose>
        <geometry><box><size>0.36 1.98 0.016</size></box></geometry>
        <material><ambient>0.04 0.26 0.40 1</ambient><diffuse>0.05 0.34 0.52 1</diffuse></material>
      </visual>
      <visual name="turn_lane">
        <pose>0.50 1.50 0.009 0 0 0</pose>
        <geometry><box><size>1.36 0.36 0.018</size></box></geometry>
        <material><ambient>0.04 0.26 0.40 1</ambient><diffuse>0.05 0.34 0.52 1</diffuse></material>
      </visual>
      <visual name="final_lane">
        <pose>1.00 2.31 0.010 0 0 0</pose>
        <geometry><box><size>0.36 1.98 0.020</size></box></geometry>
        <material><ambient>0.04 0.26 0.40 1</ambient><diffuse>0.05 0.34 0.52 1</diffuse></material>
      </visual>
    </link>

    <!-- High-contrast center-envelope boundaries; no collision geometry. -->
    <link name="corridor_edges">
      <visual name="first_left">
        <pose>0.18 0.51 0.026 0 0 0</pose>
        <geometry><box><size>0.035 1.62 0.028</size></box></geometry>
        <material><ambient>1 0.20 0.04 1</ambient><diffuse>1 0.28 0.05 1</diffuse></material>
      </visual>
      <visual name="first_right">
        <pose>-0.18 0.51 0.026 0 0 0</pose>
        <geometry><box><size>0.035 1.62 0.028</size></box></geometry>
        <material><ambient>1 0.20 0.04 1</ambient><diffuse>1 0.28 0.05 1</diffuse></material>
      </visual>
      <visual name="turn_lower">
        <pose>0.68 1.32 0.027 0 0 0</pose>
        <geometry><box><size>1.00 0.035 0.030</size></box></geometry>
        <material><ambient>1 0.20 0.04 1</ambient><diffuse>1 0.28 0.05 1</diffuse></material>
      </visual>
      <visual name="turn_upper">
        <pose>0.32 1.68 0.027 0 0 0</pose>
        <geometry><box><size>1.00 0.035 0.030</size></box></geometry>
        <material><ambient>1 0.20 0.04 1</ambient><diffuse>1 0.28 0.05 1</diffuse></material>
      </visual>
      <visual name="final_left">
        <pose>1.18 2.49 0.028 0 0 0</pose>
        <geometry><box><size>0.035 1.62 0.032</size></box></geometry>
        <material><ambient>1 0.20 0.04 1</ambient><diffuse>1 0.28 0.05 1</diffuse></material>
      </visual>
      <visual name="final_right">
        <pose>0.82 2.49 0.028 0 0 0</pose>
        <geometry><box><size>0.035 1.62 0.032</size></box></geometry>
        <material><ambient>1 0.20 0.04 1</ambient><diffuse>1 0.28 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="corner_markers">
      <visual name="corner_one">
        <pose>0 1.50 0.045 0 0 0.785398</pose>
        <geometry><box><size>0.13 0.13 0.07</size></box></geometry>
        <material><ambient>1 0.86 0.04 1</ambient><diffuse>1 0.92 0.08 1</diffuse></material>
      </visual>
      <visual name="corner_two">
        <pose>1.00 1.50 0.045 0 0 0.785398</pose>
        <geometry><box><size>0.13 0.13 0.07</size></box></geometry>
        <material><ambient>1 0.86 0.04 1</ambient><diffuse>1 0.92 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="finish_marker">
      <pose>1.00 3.00 0.034 0 0 0</pose>
      <visual name="finish_one">
        <pose>-0.135 0 0 0 0 0</pose>
        <geometry><box><size>0.09 0.08 0.036</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <visual name="finish_two">
        <pose>-0.045 0 0 0 0 0</pose>
        <geometry><box><size>0.09 0.08 0.036</size></box></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
      </visual>
      <visual name="finish_three">
        <pose>0.045 0 0 0 0 0</pose>
        <geometry><box><size>0.09 0.08 0.036</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <visual name="finish_four">
        <pose>0.135 0 0 0 0 0</pose>
        <geometry><box><size>0.09 0.08 0.036</size></box></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
