<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tinympc_corridor">
    <static>true</static>

    <!--
      PX4 NED x (forward) maps to Gazebo world y, while PX4 NED y
      (lateral) maps to Gazebo world x. The wall inner faces are at
      approximately +/-0.79 m. The extra clearance accounts for the x500
      footprint; the MPC center-position bound remains the tighter
      +/-0.35 m corridor enforced by the controller.
    -->
    <link name="floor_lane">
      <pose>0 1.5 0.006 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box><size>1.58 4.0 0.012</size></box>
        </geometry>
        <material>
          <ambient>0.10 0.18 0.22 1</ambient>
          <diffuse>0.12 0.24 0.29 1</diffuse>
          <specular>0.05 0.08 0.10 1</specular>
        </material>
      </visual>
    </link>

    <link name="left_wall">
      <pose>0.85 1.5 0.50 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>0.12 4.0 1.0</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.12 4.0 1.0</size></box>
        </geometry>
        <material>
          <ambient>0.05 0.42 0.95 1</ambient>
          <diffuse>0.08 0.52 1.00 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
    </link>

    <link name="right_wall">
      <pose>-0.85 1.5 0.50 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>0.12 4.0 1.0</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.12 4.0 1.0</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.16 0.10 1</ambient>
          <diffuse>1.00 0.23 0.12 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
    </link>

    <link name="finish_marker">
      <pose>0 3.45 0.04 0 0 0</pose>
      <visual name="visual">
        <geometry>
          <box><size>1.58 0.08 0.08</size></box>
        </geometry>
        <material>
          <ambient>1.0 0.75 0.05 1</ambient>
          <diffuse>1.0 0.82 0.10 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
